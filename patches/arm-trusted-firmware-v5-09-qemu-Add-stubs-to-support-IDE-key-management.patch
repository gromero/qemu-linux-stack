From dafe96015a6a90e6e89dd2737cb64639e0a5d8cf Mon Sep 17 00:00:00 2001
From: Mathieu Poirier <mathieu.poirier@linaro.org>
Date: Mon, 16 Nov 2026 15:30:12 +0100
Subject: [PATCH] feat(qemu): Add stubs to support IDE key management

Stub out the plat_rmmd_el3_ide_key_*() hooks and enable
RMMD_ENABLE_IDE_KEY_PROG on qemu_sbsa so that the RMM's EL3 IDE key
programming SMCs succeed, mirroring plat/arm/board/fvp/fvp_ide_keymgmt.c.

[gromero: rebased: key the build on ENABLE_RMM instead of ENABLE_RME]
---
 plat/qemu/qemu_sbsa/platform.mk        |  5 +++
 plat/qemu/qemu_sbsa/sbsa_ide_keymgmt.c | 48 ++++++++++++++++++++++++++
 2 files changed, 53 insertions(+)
 create mode 100644 plat/qemu/qemu_sbsa/sbsa_ide_keymgmt.c

diff --git a/plat/qemu/qemu_sbsa/platform.mk b/plat/qemu/qemu_sbsa/platform.mk
index bf0a1fef..b2b3cf6b 100644
--- a/plat/qemu/qemu_sbsa/platform.mk
+++ b/plat/qemu/qemu_sbsa/platform.mk
@@ -20,6 +20,10 @@ NEED_BL32		:=	yes
 EL3_EXCEPTION_HANDLING	:=	1
 endif
 
+ifeq (${ENABLE_RMM},1)
+    RMMD_ENABLE_IDE_KEY_PROG	:= 1
+endif
+
 include plat/qemu/common/common.mk
 
 # Enable new version of image loading on QEMU platforms
@@ -72,6 +76,7 @@ endif
 
 ifeq (${ENABLE_RMM},1)
 BL31_SOURCES		+=	${PLAT_QEMU_PATH}/plat_rmm_mem_carveout.c
+BL31_SOURCES		+=	${PLAT_QEMU_PATH}/sbsa_ide_keymgmt.c
 # SMMUv3 is handed over to the RMM, so EL3 needs to set it up
 BL31_SOURCES		+=	drivers/arm/smmu/smmu_v3.c			\
 				drivers/delay_timer/delay_timer.c		\
diff --git a/plat/qemu/qemu_sbsa/sbsa_ide_keymgmt.c b/plat/qemu/qemu_sbsa/sbsa_ide_keymgmt.c
new file mode 100644
index 00000000..ff053510
--- /dev/null
+++ b/plat/qemu/qemu_sbsa/sbsa_ide_keymgmt.c
@@ -0,0 +1,48 @@
