From 6b85e96fb7ac8d72d0a4cff8825dffb3631fbcee Mon Sep 17 00:00:00 2001
From: Gustavo Romero <gusbromero@gmail.com>
Date: Sun, 15 Nov 2026 21:07:22 +0100
Subject: [PATCH 2/2] feat(qemu-sbsa): add FIRME IDE-KM stubs

TF-RMM main programs Root Port IDE keys through the FIRME IDE-KM
interface rather than the deprecated RMMD IDE key SMCs. Enable
FIRME_SUPPORT_IDE_KM on sbsa-ref when the RMM is enabled and provide
no-op key programming hooks, as QEMU does not model an IDE key unit.

Replaces the TF-A v2.13-based patch
'feat(qemu): Add stubs to support IDE key management'.
---
 plat/qemu/qemu_sbsa/platform.mk         | 20 +++++++++++
 plat/qemu/qemu_sbsa/sbsa_firme_ide_km.c | 45 +++++++++++++++++++++++++
 2 files changed, 65 insertions(+)
 create mode 100644 plat/qemu/qemu_sbsa/sbsa_firme_ide_km.c

diff --git a/plat/qemu/qemu_sbsa/platform.mk b/plat/qemu/qemu_sbsa/platform.mk
index c1c26f18..cb4cc182 100644
--- a/plat/qemu/qemu_sbsa/platform.mk
+++ b/plat/qemu/qemu_sbsa/platform.mk
@@ -12,6 +12,11 @@ CRASH_REPORTING		:= 1
 SEPARATE_CODE_AND_RODATA := 1
 ENABLE_STACK_PROTECTOR	 := 0
 
+# The RMM programs PCIe IDE keys through the FIRME IDE-KM interface
+ifeq (${ENABLE_RMM},1)
+    FIRME_SUPPORT_IDE_KM	:= 1
+endif
+
 include plat/qemu/common/common.mk
 
 # Enable new version of image loading on QEMU platforms
@@ -61,6 +66,21 @@ endif
 
 ifeq (${ENABLE_RMM},1)
 BL31_SOURCES		+=	${PLAT_QEMU_PATH}/plat_rmm_mem_carveout.c
+endif
+
+ifeq (${FIRME_SUPPORT_IDE_KM},1)
+# sbsa-ref has a single PCIe Root Complex
+PLAT_PCIE_ROOT_COMPLEX_MAX	:= 1
+$(eval $(call add_define,PLAT_PCIE_ROOT_COMPLEX_MAX))
+
+# Key programming completes synchronously, no pending operations
+PLAT_IDE_KM_PENDING_OPS_MAX	:= 0
+$(eval $(call add_define,PLAT_IDE_KM_PENDING_OPS_MAX))
+
+BL31_SOURCES		+=	${PLAT_QEMU_PATH}/sbsa_firme_ide_km.c
+endif
+
+ifeq (${ENABLE_RMM},1)
 # SMMUv3 is handed over to the RMM, so EL3 needs to set it up
 BL31_SOURCES		+=	drivers/arm/smmu/smmu_v3.c			\
 				drivers/delay_timer/delay_timer.c		\
diff --git a/plat/qemu/qemu_sbsa/sbsa_firme_ide_km.c b/plat/qemu/qemu_sbsa/sbsa_firme_ide_km.c
new file mode 100644
index 00000000..ce715a4c
--- /dev/null
+++ b/plat/qemu/qemu_sbsa/sbsa_firme_ide_km.c
@@ -0,0 +1,45 @@
+/*
+ * Copyright (c) 2026, Arm Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <errno.h>
+
+#include <plat/common/platform.h>
+
+/* See @sbsa_ref_memmap in QEMU's hw/arm/sbsa-ref.c */
+#define SBSA_PCIE_ECAM_BASE	0xf0000000UL
+
+/*
+ * QEMU does not model a Root Port IDE key-management unit, so key
+ * programming is accepted and ignored. This is enough for the RMM to
+ * walk through the IDE stream setup flow.
+ */
+int plat_get_root_complex_index(uint64_t ecam_address)
+{
+	if (ecam_address != SBSA_PCIE_ECAM_BASE) {
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int plat_ide_km_keyset_prog(uint64_t ecam_address, uint64_t flags,
+			    uint64_t keyset_id, uint64_t keyqw0,
+			    uint64_t keyqw1, uint64_t keyqw2, uint64_t keyqw3)
+{
+	return 0;
+}
+
+int plat_ide_km_keyset_go(uint64_t ecam_address, uint64_t flags,
+			  uint64_t keyset_id)
+{
+	return 0;
+}
+
+int plat_ide_km_keyset_stop(uint64_t ecam_address, uint64_t flags,
+			    uint64_t keyset_id)
+{
+	return 0;
+}
-- 
