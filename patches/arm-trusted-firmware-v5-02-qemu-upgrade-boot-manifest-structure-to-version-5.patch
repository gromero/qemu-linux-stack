+ * |   322  |    mapping_top     |                    |
+ * +--------+--------------------+   bdf_mappings[0]  |
+ * |   324  |    mapping_off     |                    |
+ * +--------+--------------------+                    |
+ * |   326  |     smmu_idx       |                    |
+ * +--------+--------------------+--------------------+
  */
 
 int plat_rmmd_load_manifest(struct rmm_manifest *manifest)
